# Copie este arquivo para ".env" (não versionado) antes de rodar o projeto.

# Substitua os valores abaixo antes de executar o Compose.
DB2INST1_PASSWORD=defina-uma-senha-forte
DB2_PASSWORD=defina-uma-senha-forte

# Senha inicial dos 2 usuários seed do NSP (ana.qualidade / carlos.nsp).
# A aplicação não inicia o seed sem esta variável.
ADMIN_SENHA_INICIAL=defina-uma-senha-inicial-forte
